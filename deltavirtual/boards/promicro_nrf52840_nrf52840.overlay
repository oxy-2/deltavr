/*
 * Route Zephyr console/shell to the hardware UART so Renode can show it
 * in `showAnalyzer uart0`. The default promicro_nrf52840 console is USB
 * CDC ACM, which Renode does not emulate.
 *
 * UART0 on this board is P0.09 (TX) / P0.10 (RX).
 */

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
		zephyr,bt-mon-uart = &uart0;
		zephyr,bt-c2h-uart = &uart0;
	};
};

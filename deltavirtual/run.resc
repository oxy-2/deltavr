include @nrf24l01.cs
include @lsm6dsv.cs

using sysbus
mach create "headset"
machine LoadPlatformDescription @platform_descriptions/headset_wiring.repl

showAnalyzer sysbus.uart0

mach create "controller"
machine LoadPlatformDescription @platform_descriptions/controller_wiring.repl

showAnalyzer sysbus.uart0
start